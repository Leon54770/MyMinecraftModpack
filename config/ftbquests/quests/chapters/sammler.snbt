		{
			dependencies: ["11EDBA459BD538B6"]
			icon: {
				id: "minecraft:chiseled_bookshelf"
			}
			id: "71A8E6EBBA0E2C7A"
			rewards: [
				{
					id: "19CA524FEA999879"
					item: {
						components: {
							"minecraft:written_book_content": {
								author: "Der letzte Wächter"
								pages: [
									{
										raw: "\"Die erste Notiz\\n\\n„Wer das liest, steht auf einem Splitter unserer Welt. Darunter schläft das Herz der Leere.“\""
									}
									{
										raw: "\"Sternenstaub\\n\\n„Einst siebten wir Sternenstaub. Du siebst Kies. Es ist derselbe Anfang.“\""
									}
									{
										raw: "\"Der Funke\\n\\n„Das erste Metall. Wir nannten es den Funken, weil danach alles schneller brannte.“\""
									}
									{
										raw: "\"Zurück zum Leben\\n\\n„Eine Insel, die sich selbst nährt. So fängt der Weg zurück an.“\""
									}
									{
										raw: "\"Die Leitungen\\n\\n„Wir verlegten Leitungen bis unter die Wolken. Wenn der Strom floss, summte die ganze Insel.“\""
									}
									{
										raw: "\"Die erste Maschine\\n\\n„Unsere Maschinen liefen Tag und Nacht, bis sie verstummten. Du hast gerade die erste wieder geweckt.“\""
									}
									{
										raw: "\"Der erste Splitter\\n\\n„Das Herz ist nicht gestorben, es ist zersprungen. Sieben Splitter. Einen davon hältst du jetzt in der Hand. Er ist warm.“\""
									}
									{
										raw: "\"Die zerbrochene Unterwelt\\n\\n„Auch die Unterwelt zerbrach. Unsere Festungen hängen dort noch in der Luft, leer wie wir.“\""
									}
									{
										raw: "\"Gier\\n\\n„Aus jedem Brocken das Vierfache. So reich waren wir. So gierig.“\""
									}
									{
										raw: "\"Die Werkstatt\\n\\n„Hier haben wir das Herz geschmiedet, und hier ist es zersprungen. Ich konnte nur den Bauplan retten.“\""
									}
									{
										raw: "\"Vier von sieben\\n\\n„Erde, Glut, Strom, Ordnung. Damit lief unsere Welt. Was fehlte, war das Schwerste: Leben, Geist und die Leere selbst.“\""
									}
									{
										raw: "\"Netze, die denken\\n\\n„Unsere Netze dachten mit. Am Ende dachten sie schneller als wir.“\""
									}
									{
										raw: "\"Felder aus Erz\\n\\n„Als die Minen versiegt waren, ließen wir Erz auf Feldern wachsen. Wenigstens das war richtig.“\""
									}
									{
										raw: "\"Kraft aus der Leere\\n\\n„Wir nahmen die Kraft aus der Leere, nicht aus Kohle. Wir nahmen zu viel, und der Boden riss.“\""
									}
									{
										raw: "\"Das letzte Buch\\n\\n„Unsere Magier schrieben, bis die Seiten glühten. Nur dieses Buch hat das Zerbrechen überstanden.“\""
									}
									{
										raw: "\"Ein Weg genügt\\n\\n„Wir wollten Maschine und Magie zugleich, und beide ganz. Einer der Wege hätte gereicht.“\""
									}
									{
										raw: "\"Feinde auswendig\\n\\n„Wir lernten unsere Feinde auswendig, bis wir sie nicht mehr bekämpfen mussten.“\""
									}
									{
										raw: "\"Der Wächter am Ende\\n\\n„Der Drache bewachte das Ende. Nicht für uns. Vor uns.“\""
									}
									{
										raw: "\"Der Herzschlag\\n\\n„Antimaterie, der Herzschlag der Leere in einer Kapsel. Behandle sie mit Respekt.“\""
									}
									{
										raw: "\"Sieben in einem\\n\\n„Das Herz ist ganz. Es wird erst schlagen, wenn ich weiß, dass du es nicht so behandelst wie wir.“\""
									}
									{
										raw: "\"Der letzte Wächter\\n\\n„Wenn du das liest, hast du mich besiegt. Gut. Ich habe lange genug gewacht. Jetzt wachst du.“\""
									}
									{
										raw: "\"Das Erbe\\n\\n„Wer das Herz wieder schlagen lässt, trägt unser Erbe. Nimm nur, was du brauchst. Wir nahmen alles.“\""
									}
								]
								resolved: 1b
								title: {
									raw: "Codex der Erbauer"
								}
							}
						}
						count: 1
						id: "minecraft:written_book"
					}
					type: "item"
				}
